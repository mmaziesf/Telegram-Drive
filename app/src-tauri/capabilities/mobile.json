{
  "identifier": "mobile-only",
  "description": "Permissions required only on Android",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "store:default",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/mmaziesf/Telegram-Drive"
        },
        {
          "url": "https://github.com/mmaziesf/Telegram-Drive/blob/main/PRIVACY.md"
        },
        {
          "url": "https://github.com/caamer20/Telegram-Drive"
        },
        {
          "url": "https://core.telegram.org/api/terms"
        },
        {
          "url": "https://telegram.org/faq#q-how-does-account-self-destruction-work"
        }
      ]
    }
  ]
}
